# ============================================
# ERP System — Local Development Environment Variables
# ============================================
# Copy .env.example to .env and fill in actual values.
# NEVER commit .env — .gitignore excludes it. This template IS committed.
#
# Consumed by three things:
#   1. Spring Boot   — application{,-dev,-prod}.properties ${VAR} placeholders
#   2. Docker Compose — docker compose --env-file .env -f docker/docker-compose.yml up -d
#   3. Claude Code MCP — .mcp.json (postgres DATABASE_URI, TestSprite API_KEY).
#      MCP reads the shell environment, NOT this file, so export it first:
#        set -a && source .env && set +a
# ============================================

# --- Profile ---------------------------------------------------------
# dev = local (localhost fallbacks). prod = container, no fallbacks at all.
SPRING_PROFILES_ACTIVE=dev

# --- Database (PostgreSQL) -------------------------------------------
# DB_URL is what Spring connects with; DB_NAME is what Docker Compose
# creates and what .mcp.json builds DATABASE_URI from. Keep the database
# name in DB_URL and DB_NAME identical or the app and the MCP server will
# point at different databases.
DB_URL=jdbc:postgresql://localhost:5432/erp_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=erp_db

# --- Redis (cache) ---------------------------------------------------
# REDIS_PORT is also the host port published by docker-compose.
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT (SECURITY module access/refresh tokens) ---------------------
# Min 256 bits. Rotating this invalidates every issued access token.
JWT_SECRET=dev-only-secret-minimum-256-bits-long-do-not-use-in-prod

# --- FILE access token (RULE-FILE-003 — AES/GCM download tokens) ------
# Separate from JWT on purpose; SHA-256-derived into a 256-bit AES key.
FILE_ACCESS_TOKEN_SECRET=dev-only-file-token-secret-minimum-256-bits-do-not-use-in-prod

# --- Mail (Gmail SMTP) -----------------------------------------------
# MAIL_PASSWORD must be a Google App Password, NOT your account password:
# Google Account → Security → 2-Step Verification ON → App Passwords.
# Leave MAIL_USERNAME/MAIL_PASSWORD empty in dev to disable outbound mail.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Frontend --------------------------------------------------------
# Base URL used to build clickable links in emails (e.g. password reset).
FRONTEND_URL=http://localhost:4200

# --- TestSprite MCP server (API integration test generation) ----------
TESTSPRITE_API_KEY=your-api-key
