<?xml version="1.0" encoding="UTF-8"?>
<!-- account-statement: FIN print template (JasperReports 7; editable in Jaspersoft Studio 7). Left-to-right design; the Arabic print mirrors it at load (TemplatePrinter). Labels: reports/fin/i18n/fin_<lang>.properties + the common print labels. The SQL reads POSTED lines live, exactly as ReportService does. -->
<jasperReport name="account-statement" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenResourceMissingType="Key">
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.keep.first.band.1" value="columnHeader"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.band.2" value="pageFooter"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.logo" value="logo"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.printed" value="printed"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.sign" value="sign"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.rule" value="rule"/>
	<style name="Base" default="true" fontName="ERP Arabic" fontSize="8.5"/>
	<parameter name="REPORT_TITLE" class="java.lang.String"/>
	<parameter name="COMPANY_NAME" class="java.lang.String"/>
	<parameter name="COMPANY_LOGO" class="java.lang.Object"/>
	<parameter name="PRINTED_BY" class="java.lang.String"/>
	<parameter name="PRINTED_AT" class="java.util.Date"/>
	<parameter name="CRITERIA_TEXT" class="java.lang.String"/>
	<parameter name="IS_AR" class="java.lang.Boolean"/>
	<parameter name="ACCOUNT_ID" class="java.lang.Long"/>
	<parameter name="FROM_DATE" class="java.sql.Date"/>
	<parameter name="TO_DATE" class="java.sql.Date"/>
	<parameter name="DIMENSION_ID" class="java.lang.Long"/>
	<parameter name="DIMENSION_VALUE_ID" class="java.lang.Long"/>
	<parameter name="JOURNAL_TYPE_LABELS" class="java.util.Map"/>
	<parameter name="NATURE_LABELS" class="java.util.Map"/>
	<query language="SQL"><![CDATA[WITH RECURSIVE tree AS (
  SELECT account_pk FROM fin_account WHERE account_pk = $P{ACCOUNT_ID}
  UNION ALL
  SELECT c.account_pk FROM fin_account c JOIN tree t ON c.parent_account_id = t.account_pk
), moves AS (
  SELECT l.account_id, e.doc_date, e.doc_no, l.line_no, e.journal_type_code, e.event_reference,
         COALESCE(NULLIF(l.description_ar, ''), e.description_ar) AS desc_ar,
         COALESCE(NULLIF(l.description_en, ''), e.description_en) AS desc_en,
         CASE WHEN UPPER(l.direction_code) = 'DEBIT' THEN COALESCE(l.amount, 0) ELSE 0 END AS debit_amount,
         CASE WHEN UPPER(l.direction_code) = 'DEBIT' THEN 0 ELSE COALESCE(l.amount, 0) END AS credit_amount
  FROM fin_journal_line l
  JOIN fin_journal_entry e ON e.journal_entry_pk = l.journal_entry_id
  WHERE l.account_id IN (SELECT account_pk FROM tree) AND e.status_code = 'POSTED'
  AND (CAST($P{DIMENSION_ID} AS bigint) IS NULL OR EXISTS (SELECT 1 FROM fin_journal_line_dim jd
       WHERE jd.journal_line_id = l.journal_line_pk AND jd.dimension_id = $P{DIMENSION_ID}))
  AND (CAST($P{DIMENSION_VALUE_ID} AS bigint) IS NULL OR EXISTS (SELECT 1 FROM fin_journal_line_dim jv
       WHERE jv.journal_line_id = l.journal_line_pk AND jv.dimension_value_id = $P{DIMENSION_VALUE_ID}))
), opening AS (
  SELECT account_id, SUM(debit_amount) - SUM(credit_amount) AS net FROM moves WHERE doc_date < $P{FROM_DATE} GROUP BY account_id
), period AS (
  SELECT * FROM moves WHERE doc_date >= $P{FROM_DATE} AND doc_date <= $P{TO_DATE}
), accounts AS (
  SELECT a.account_pk, a.code, a.name_ar, a.name_en, a.nature_code,
         CASE WHEN UPPER(a.nature_code) = 'DEBIT' THEN 1 ELSE -1 END AS sign,
         (CASE WHEN UPPER(a.nature_code) = 'DEBIT' THEN 1 ELSE -1 END) * COALESCE(o.net, 0) AS opening_balance
  FROM fin_account a LEFT JOIN opening o ON o.account_id = a.account_pk
  WHERE a.account_pk IN (SELECT account_id FROM period UNION SELECT account_id FROM opening WHERE net <> 0)
)
SELECT x.code AS account_code, x.name_ar, x.name_en, x.nature_code, x.opening_balance,
       CASE WHEN ROW_NUMBER() OVER (PARTITION BY x.account_pk ORDER BY p.doc_date, p.doc_no, p.line_no) = 1
            THEN x.opening_balance ELSE 0 END AS opening_share,
       p.doc_date, p.doc_no, p.journal_type_code, p.event_reference, p.desc_ar, p.desc_en,
       p.debit_amount, p.credit_amount, x.sign * (COALESCE(p.debit_amount, 0) - COALESCE(p.credit_amount, 0)) AS signed_amount,
       x.opening_balance + SUM(x.sign * (COALESCE(p.debit_amount, 0) - COALESCE(p.credit_amount, 0)))
           OVER (PARTITION BY x.account_pk ORDER BY p.doc_date, p.doc_no, p.line_no ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
           AS running_balance
FROM accounts x LEFT JOIN period p ON p.account_id = x.account_pk
ORDER BY x.code, p.doc_date, p.doc_no, p.line_no]]></query>
	<field name="account_code" class="java.lang.String"/>
	<field name="name_ar" class="java.lang.String"/>
	<field name="name_en" class="java.lang.String"/>
	<field name="nature_code" class="java.lang.String"/>
	<field name="opening_balance" class="java.math.BigDecimal"/>
	<field name="opening_share" class="java.math.BigDecimal"/>
	<field name="doc_date" class="java.util.Date"/>
	<field name="doc_no" class="java.lang.String"/>
	<field name="journal_type_code" class="java.lang.String"/>
	<field name="event_reference" class="java.lang.String"/>
	<field name="desc_ar" class="java.lang.String"/>
	<field name="desc_en" class="java.lang.String"/>
	<field name="debit_amount" class="java.math.BigDecimal"/>
	<field name="credit_amount" class="java.math.BigDecimal"/>
	<field name="signed_amount" class="java.math.BigDecimal"/>
	<field name="running_balance" class="java.math.BigDecimal"/>
	<variable name="A_DEBIT" calculation="Sum" resetType="Group" resetGroup="AccountGroup" class="java.math.BigDecimal"><expression><![CDATA[$F{debit_amount}]]></expression></variable>
	<variable name="A_CREDIT" calculation="Sum" resetType="Group" resetGroup="AccountGroup" class="java.math.BigDecimal"><expression><![CDATA[$F{credit_amount}]]></expression></variable>
	<variable name="A_SIGNED" calculation="Sum" resetType="Group" resetGroup="AccountGroup" class="java.math.BigDecimal"><expression><![CDATA[$F{signed_amount}]]></expression></variable>
	<variable name="T_DEBIT" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{debit_amount}]]></expression></variable>
	<variable name="T_CREDIT" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{credit_amount}]]></expression></variable>
	<variable name="T_OPENING" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{opening_share}]]></expression></variable>
	<variable name="T_SIGNED" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{signed_amount}]]></expression></variable>
	<variable name="ACCOUNTS" calculation="DistinctCount" class="java.lang.Integer"><expression><![CDATA[$F{account_code}]]></expression></variable>
	<group name="AccountGroup"><expression><![CDATA[$F{account_code}]]></expression><groupHeader><band height="48"><element kind="textField" x="0" y="6" width="267" height="20" fontSize="9" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{col.account} + ": " + ($F{account_code} + " — " + ($P{IS_AR} ? ($F{name_ar} != null && !$F{name_ar}.isBlank() ? $F{name_ar} : $F{name_en}) : ($F{name_en} != null && !$F{name_en}.isBlank() ? $F{name_en} : $F{name_ar})))]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="267" y="6" width="267" height="20" fontSize="9" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{col.nature} + ": " + ((String) $P{NATURE_LABELS}.getOrDefault($F{nature_code}, $F{nature_code}))]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="534" y="6" width="268" height="20" fontSize="9" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{openingBalance} + ": " + (new java.text.DecimalFormat("#,##0.00").format($F{opening_balance}))]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="0" y="26" width="69" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.docDate}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="69" y="26" width="99" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.docNo}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="168" y="26" width="84" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.journalType}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="252" y="26" width="206" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.description}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="458" y="26" width="107" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.eventReference}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="565" y="26" width="76" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.debit}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="641" y="26" width="76" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.credit}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="717" y="26" width="85" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.runningBalance}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></groupHeader><groupFooter><band height="46"><element kind="textField" x="0" y="0" width="565" height="20" bold="true" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{periodMovement}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="565" y="0" width="76" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{A_DEBIT}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="641" y="0" width="76" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{A_CREDIT}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="717" y="0" width="85" height="20" bold="true" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[""]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="0" y="20" width="717" height="20" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{closingBalance}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="717" y="20" width="85" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{opening_balance}.add($V{A_SIGNED})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></groupFooter></group>
	<title height="100"><element kind="image" key="logo" x="0" y="0" width="48" height="48" scaleImage="RetainShape" hImageAlign="Left" onErrorType="Blank"><expression><![CDATA[$P{COMPANY_LOGO}]]></expression></element><element kind="textField" x="0" y="0" width="802" height="26" fontSize="14" bold="true" forecolor="#1F3A5F" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{COMPANY_NAME}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="0" y="26" width="802" height="24" fontSize="12.5" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{REPORT_TITLE}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="rule" x="0" y="56" width="802" height="1"><pen lineWidth="1.0" lineColor="#1F3A5F"/></element><element kind="textField" x="0" y="60" width="802" height="18" fontSize="9" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{CRITERIA_TEXT}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="0" y="80" width="401" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{printedBy} + ": " + ($P{PRINTED_BY} == null ? "" : $P{PRINTED_BY})]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="401" y="80" width="401" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{printedAt} + ": " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format($P{PRINTED_AT})]]></expression><box leftPadding="2" rightPadding="2"/></element></title>
	<detail><band height="18"><printWhenExpression><![CDATA[$F{doc_no} != null]]></printWhenExpression><element kind="textField" x="0" y="0" width="69" height="18" pattern="yyyy-MM-dd" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$F{doc_date}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="69" y="0" width="99" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$F{doc_no}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="168" y="0" width="84" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$F{journal_type_code} == null ? null : (String) $P{JOURNAL_TYPE_LABELS}.getOrDefault($F{journal_type_code}, $F{journal_type_code})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="252" y="0" width="206" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$P{IS_AR} ? ($F{desc_ar} != null && !$F{desc_ar}.isBlank() ? $F{desc_ar} : $F{desc_en}) : ($F{desc_en} != null && !$F{desc_en}.isBlank() ? $F{desc_en} : $F{desc_ar})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="458" y="0" width="107" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$F{event_reference}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="565" y="0" width="76" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{debit_amount}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="641" y="0" width="76" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{credit_amount}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="717" y="0" width="85" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{running_balance}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></detail>
	<pageFooter height="20"><element kind="textField" x="281" y="4" width="120" height="14" fontSize="7.5" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{page} + " " + $V{PAGE_NUMBER} + " " + $R{of} + " "]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="401" y="4" width="60" height="14" fontSize="7.5" evaluationTime="Report" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA["" + $V{PAGE_NUMBER}]]></expression><box leftPadding="2" rightPadding="2"/></element></pageFooter>
	<summary height="90"><element kind="textField" x="0" y="0" width="565" height="20" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{grandTotal} + " (" + $V{ACCOUNTS} + " " + $R{accounts} + ") — " + $R{openingBalance} + ": " + new java.text.DecimalFormat("#,##0.00").format($V{T_OPENING} == null ? java.math.BigDecimal.ZERO : $V{T_OPENING})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="565" y="0" width="76" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{T_DEBIT}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="641" y="0" width="76" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{T_CREDIT}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="717" y="0" width="85" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[($V{T_OPENING} == null ? java.math.BigDecimal.ZERO : $V{T_OPENING}).add($V{T_SIGNED} == null ? java.math.BigDecimal.ZERO : $V{T_SIGNED})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" key="sign" x="10" y="44" width="247" height="16" fontSize="9" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{sign.preparedBy}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="sign" x="30" y="84" width="207" height="1"><pen lineWidth="0.75" lineColor="#55606B"/></element><element kind="textField" key="sign" x="277" y="44" width="247" height="16" fontSize="9" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{sign.reviewedBy}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="sign" x="297" y="84" width="207" height="1"><pen lineWidth="0.75" lineColor="#55606B"/></element><element kind="textField" key="sign" x="544" y="44" width="247" height="16" fontSize="9" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{sign.approvedBy}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="sign" x="564" y="84" width="207" height="1"><pen lineWidth="0.75" lineColor="#55606B"/></element></summary>
</jasperReport>
