<?xml version="1.0" encoding="UTF-8"?>
<!-- trial-balance: FIN print template (JasperReports 7; editable in Jaspersoft Studio 7). Left-to-right design; the Arabic print mirrors it at load (TemplatePrinter). Labels: reports/fin/i18n/fin_<lang>.properties + the common print labels. The SQL reads POSTED lines live, exactly as ReportService does. -->
<jasperReport name="trial-balance" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenResourceMissingType="Key">
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.keep.first.band.1" value="columnHeader"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.band.2" value="pageFooter"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.logo" value="logo"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.printed" value="printed"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.sign" value="sign"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.rule" value="rule"/>
	<style name="Base" default="true" fontName="ERP Arabic" fontSize="8.5"/>
	<parameter name="REPORT_TITLE" class="java.lang.String"/>
	<parameter name="COMPANY_NAME" class="java.lang.String"/>
	<parameter name="COMPANY_LOGO" class="java.lang.Object"/>
	<parameter name="PRINTED_BY" class="java.lang.String"/>
	<parameter name="PRINTED_AT" class="java.util.Date"/>
	<parameter name="CRITERIA_TEXT" class="java.lang.String"/>
	<parameter name="IS_AR" class="java.lang.Boolean"/>
	<parameter name="PERIOD_ID" class="java.lang.Long"/>
	<parameter name="ACCOUNT_TYPE" class="java.lang.String"/>
	<parameter name="DIMENSION_ID" class="java.lang.Long"/>
	<parameter name="DIMENSION_VALUE_ID" class="java.lang.Long"/>
	<parameter name="TYPE_LABELS" class="java.util.Map"/>
	<parameter name="NATURE_LABELS" class="java.util.Map"/>
	<query language="SQL"><![CDATA[SELECT b.account_code, b.name_ar, b.name_en, b.account_type_code, b.nature_code,
       b.debit_total, b.credit_total,
       CASE WHEN b.debit_total - b.credit_total > 0 THEN b.debit_total - b.credit_total ELSE 0 END AS debit_balance,
       CASE WHEN b.debit_total - b.credit_total > 0 THEN 0 ELSE b.credit_total - b.debit_total END AS credit_balance,
       CASE WHEN UPPER(b.nature_code) = 'DEBIT' THEN b.debit_total - b.credit_total
            ELSE b.credit_total - b.debit_total END AS signed_balance
FROM (
SELECT a.code AS account_code, a.name_ar, a.name_en, a.account_type_code, a.nature_code,
       SUM(CASE WHEN l.direction_code = 'DEBIT' THEN l.amount ELSE 0 END) AS debit_total,
       SUM(CASE WHEN l.direction_code = 'DEBIT' THEN 0 ELSE l.amount END) AS credit_total
FROM fin_journal_line l
JOIN fin_journal_entry e ON e.journal_entry_pk = l.journal_entry_id
JOIN fin_account a ON a.account_pk = l.account_id
WHERE e.status_code = 'POSTED'
  AND (CAST($P{PERIOD_ID} AS bigint) IS NULL OR e.period_id = $P{PERIOD_ID})
  AND (CAST($P{DIMENSION_ID} AS bigint) IS NULL OR EXISTS (SELECT 1 FROM fin_journal_line_dim jd
       WHERE jd.journal_line_id = l.journal_line_pk AND jd.dimension_id = $P{DIMENSION_ID}))
  AND (CAST($P{DIMENSION_VALUE_ID} AS bigint) IS NULL OR EXISTS (SELECT 1 FROM fin_journal_line_dim jv
       WHERE jv.journal_line_id = l.journal_line_pk AND jv.dimension_value_id = $P{DIMENSION_VALUE_ID}))
GROUP BY a.account_pk, a.code, a.name_ar, a.name_en, a.account_type_code, a.nature_code
) b
WHERE (CAST($P{ACCOUNT_TYPE} AS varchar) IS NULL OR b.account_type_code = $P{ACCOUNT_TYPE})
ORDER BY b.account_code]]></query>
	<field name="account_code" class="java.lang.String"/>
	<field name="name_ar" class="java.lang.String"/>
	<field name="name_en" class="java.lang.String"/>
	<field name="account_type_code" class="java.lang.String"/>
	<field name="nature_code" class="java.lang.String"/>
	<field name="debit_total" class="java.math.BigDecimal"/>
	<field name="credit_total" class="java.math.BigDecimal"/>
	<field name="debit_balance" class="java.math.BigDecimal"/>
	<field name="credit_balance" class="java.math.BigDecimal"/>
	<field name="signed_balance" class="java.math.BigDecimal"/>
	<variable name="T_DEBIT" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{debit_total}]]></expression></variable>
	<variable name="T_CREDIT" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{credit_total}]]></expression></variable>
	<variable name="T_DEBIT_BAL" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{debit_balance}]]></expression></variable>
	<variable name="T_CREDIT_BAL" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{credit_balance}]]></expression></variable>
	<variable name="ROWS" calculation="Count" class="java.lang.Integer"><expression><![CDATA[$F{account_code}]]></expression></variable>
	<title height="100"><element kind="image" key="logo" x="0" y="0" width="48" height="48" scaleImage="RetainShape" hImageAlign="Left" onErrorType="Blank"><expression><![CDATA[$P{COMPANY_LOGO}]]></expression></element><element kind="textField" x="0" y="0" width="802" height="26" fontSize="14" bold="true" forecolor="#1F3A5F" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{COMPANY_NAME}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="0" y="26" width="802" height="24" fontSize="12.5" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{REPORT_TITLE}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="rule" x="0" y="56" width="802" height="1"><pen lineWidth="1.0" lineColor="#1F3A5F"/></element><element kind="textField" x="0" y="60" width="802" height="18" fontSize="9" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{CRITERIA_TEXT}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="0" y="80" width="401" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{printedBy} + ": " + ($P{PRINTED_BY} == null ? "" : $P{PRINTED_BY})]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="401" y="80" width="401" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{printedAt} + ": " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format($P{PRINTED_AT})]]></expression><box leftPadding="2" rightPadding="2"/></element></title>
	<columnHeader height="30"><element kind="textField" x="0" y="0" width="68" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.accountCode}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="68" y="0" width="163" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.accountName}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="231" y="0" width="75" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.accountType}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="306" y="0" width="54" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.nature}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="360" y="0" width="88" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.debitTotal}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="448" y="0" width="88" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.creditTotal}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="536" y="0" width="88" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.debitBalance}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="624" y="0" width="88" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.creditBalance}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="712" y="0" width="90" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.signedBalance}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></columnHeader>
	<detail><band height="18"><element kind="textField" x="0" y="0" width="68" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$F{account_code}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="68" y="0" width="163" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$P{IS_AR} ? ($F{name_ar} != null && !$F{name_ar}.isBlank() ? $F{name_ar} : $F{name_en}) : ($F{name_en} != null && !$F{name_en}.isBlank() ? $F{name_en} : $F{name_ar})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="231" y="0" width="75" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[(String) $P{TYPE_LABELS}.getOrDefault($F{account_type_code}, $F{account_type_code})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="306" y="0" width="54" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[(String) $P{NATURE_LABELS}.getOrDefault($F{nature_code}, $F{nature_code})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="360" y="0" width="88" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{debit_total}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="448" y="0" width="88" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{credit_total}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="536" y="0" width="88" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{debit_balance}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="624" y="0" width="88" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{credit_balance}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="712" y="0" width="90" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{signed_balance}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></detail>
	<pageFooter height="20"><element kind="textField" x="281" y="4" width="120" height="14" fontSize="7.5" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{page} + " " + $V{PAGE_NUMBER} + " " + $R{of} + " "]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="401" y="4" width="60" height="14" fontSize="7.5" evaluationTime="Report" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA["" + $V{PAGE_NUMBER}]]></expression><box leftPadding="2" rightPadding="2"/></element></pageFooter>
	<summary height="110"><element kind="textField" x="0" y="0" width="360" height="20" bold="true" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{total} + " (" + $V{ROWS} + " " + $R{accounts} + ")"]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="360" y="0" width="88" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{T_DEBIT}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="448" y="0" width="88" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{T_CREDIT}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="536" y="0" width="88" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{T_DEBIT_BAL}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="624" y="0" width="88" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{T_CREDIT_BAL}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="712" y="0" width="90" height="20" bold="true" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[""]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="0" y="22" width="802" height="18" fontSize="9" bold="true" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[($V{T_DEBIT_BAL} == null ? java.math.BigDecimal.ZERO : $V{T_DEBIT_BAL}).compareTo($V{T_CREDIT_BAL} == null ? java.math.BigDecimal.ZERO : $V{T_CREDIT_BAL}) == 0 ? $R{balanced} : $R{notBalanced}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="sign" x="10" y="64" width="247" height="16" fontSize="9" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{sign.preparedBy}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="sign" x="30" y="104" width="207" height="1"><pen lineWidth="0.75" lineColor="#55606B"/></element><element kind="textField" key="sign" x="277" y="64" width="247" height="16" fontSize="9" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{sign.reviewedBy}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="sign" x="297" y="104" width="207" height="1"><pen lineWidth="0.75" lineColor="#55606B"/></element><element kind="textField" key="sign" x="544" y="64" width="247" height="16" fontSize="9" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{sign.approvedBy}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="sign" x="564" y="104" width="207" height="1"><pen lineWidth="0.75" lineColor="#55606B"/></element></summary>
</jasperReport>
