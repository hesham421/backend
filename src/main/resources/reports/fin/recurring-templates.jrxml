<?xml version="1.0" encoding="UTF-8"?>
<!-- recurring-templates: FIN print template (JasperReports 7; editable in Jaspersoft Studio 7). Left-to-right design; the Arabic print mirrors it at load (TemplatePrinter). Labels: reports/fin/i18n/fin_<lang>.properties + the common print labels. The SQL reads POSTED lines live, exactly as ReportService does. -->
<jasperReport name="recurring-templates" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenResourceMissingType="Key">
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.keep.first.band.1" value="columnHeader"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.band.2" value="pageFooter"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.logo" value="logo"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.printed" value="printed"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.sign" value="sign"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.rule" value="rule"/>
	<style name="Base" default="true" fontName="ERP Arabic" fontSize="8.5"/>
	<parameter name="REPORT_TITLE" class="java.lang.String"/>
	<parameter name="COMPANY_NAME" class="java.lang.String"/>
	<parameter name="COMPANY_LOGO" class="java.lang.Object"/>
	<parameter name="PRINTED_BY" class="java.lang.String"/>
	<parameter name="PRINTED_AT" class="java.util.Date"/>
	<parameter name="CRITERIA_TEXT" class="java.lang.String"/>
	<parameter name="IS_AR" class="java.lang.Boolean"/>
	<parameter name="IDS" class="java.lang.String"/>
	<parameter name="SCHEDULE_LABELS" class="java.util.Map"/>
	<parameter name="FREQUENCY_LABELS" class="java.util.Map"/>
	<query language="SQL"><![CDATA[WITH ids AS (
  SELECT CAST(x.id AS bigint) AS id, x.ord
  FROM unnest(string_to_array($P{IDS}, ',')) WITH ORDINALITY AS x(id, ord)
)
SELECT ids.ord, t.recurring_template_pk AS template_pk, t.name_ar, t.name_en, t.schedule_type_code, t.frequency_code,
       t.start_date, t.next_run_date, t.end_date, t.is_active_fl AS active,
       l.line_no, a.code AS account_code, a.name_ar AS account_name_ar, a.name_en AS account_name_en,
       dv.name_ar AS value_name_ar, dv.name_en AS value_name_en,
       CASE WHEN UPPER(l.direction_code) = 'DEBIT' THEN l.amount ELSE 0 END AS debit_amount,
       CASE WHEN UPPER(l.direction_code) = 'DEBIT' THEN 0 ELSE l.amount END AS credit_amount
FROM ids JOIN fin_recurring_template t ON t.recurring_template_pk = ids.id
LEFT JOIN fin_recurring_template_line l ON l.recurring_template_id = t.recurring_template_pk
LEFT JOIN fin_account a ON a.account_pk = l.account_id
LEFT JOIN fin_dimension_value dv ON dv.dimension_value_pk = l.dimension_value_id
ORDER BY ids.ord, l.line_no]]></query>
	<field name="ord" class="java.lang.Long"/>
	<field name="template_pk" class="java.lang.Long"/>
	<field name="name_ar" class="java.lang.String"/>
	<field name="name_en" class="java.lang.String"/>
	<field name="schedule_type_code" class="java.lang.String"/>
	<field name="frequency_code" class="java.lang.String"/>
	<field name="start_date" class="java.util.Date"/>
	<field name="next_run_date" class="java.util.Date"/>
	<field name="end_date" class="java.util.Date"/>
	<field name="active" class="java.lang.Boolean"/>
	<field name="line_no" class="java.math.BigDecimal"/>
	<field name="account_code" class="java.lang.String"/>
	<field name="account_name_ar" class="java.lang.String"/>
	<field name="account_name_en" class="java.lang.String"/>
	<field name="value_name_ar" class="java.lang.String"/>
	<field name="value_name_en" class="java.lang.String"/>
	<field name="debit_amount" class="java.math.BigDecimal"/>
	<field name="credit_amount" class="java.math.BigDecimal"/>
	<variable name="G_DEBIT" calculation="Sum" resetType="Group" resetGroup="TemplateGroup" class="java.math.BigDecimal"><expression><![CDATA[$F{debit_amount}]]></expression></variable>
	<variable name="G_CREDIT" calculation="Sum" resetType="Group" resetGroup="TemplateGroup" class="java.math.BigDecimal"><expression><![CDATA[$F{credit_amount}]]></expression></variable>
	<variable name="TEMPLATES" calculation="DistinctCount" class="java.lang.Integer"><expression><![CDATA[$F{template_pk}]]></expression></variable>
	<group name="TemplateGroup" keepTogether="true" minHeightToStartNewPage="130"><expression><![CDATA[$F{template_pk}]]></expression><groupHeader><band height="70"><element kind="textField" x="0" y="6" width="200" height="20" fontSize="9" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{col.name} + ": " + ($P{IS_AR} ? ($F{name_ar} != null && !$F{name_ar}.isBlank() ? $F{name_ar} : $F{name_en}) : ($F{name_en} != null && !$F{name_en}.isBlank() ? $F{name_en} : $F{name_ar}))]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="200" y="6" width="200" height="20" fontSize="9" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{col.scheduleType} + ": " + ((String) $P{SCHEDULE_LABELS}.getOrDefault($F{schedule_type_code}, $F{schedule_type_code}))]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="400" y="6" width="200" height="20" fontSize="9" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{col.frequency} + ": " + ((String) $P{FREQUENCY_LABELS}.getOrDefault($F{frequency_code}, $F{frequency_code}))]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="600" y="6" width="202" height="20" fontSize="9" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{col.status} + ": " + (Boolean.FALSE.equals($F{active}) ? $R{inactive} : $R{active})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="0" y="26" width="802" height="20" fontSize="8.5" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{col.startDate} + ": " + ($F{start_date} == null ? "" : new java.text.SimpleDateFormat("yyyy-MM-dd").format($F{start_date})) + "   |   " + $R{col.nextRunDate} + ": " + ($F{next_run_date} == null ? "" : new java.text.SimpleDateFormat("yyyy-MM-dd").format($F{next_run_date})) + "   |   " + $R{col.endDate} + ": " + ($F{end_date} == null ? "" : new java.text.SimpleDateFormat("yyyy-MM-dd").format($F{end_date}))]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="0" y="46" width="51" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.lineNo}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="51" y="46" width="93" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.accountCode}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="144" y="46" width="247" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.accountName}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="391" y="46" width="185" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.dimensionValue}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="576" y="46" width="113" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.debit}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="689" y="46" width="113" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.credit}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></groupHeader><groupFooter><band height="30"><element kind="textField" x="0" y="0" width="576" height="20" bold="true" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{templateTotal}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="576" y="0" width="113" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{G_DEBIT}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="689" y="0" width="113" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{G_CREDIT}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></groupFooter></group>
	<title height="100"><element kind="image" key="logo" x="0" y="0" width="48" height="48" scaleImage="RetainShape" hImageAlign="Left" onErrorType="Blank"><expression><![CDATA[$P{COMPANY_LOGO}]]></expression></element><element kind="textField" x="0" y="0" width="802" height="26" fontSize="14" bold="true" forecolor="#1F3A5F" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{COMPANY_NAME}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="0" y="26" width="802" height="24" fontSize="12.5" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{REPORT_TITLE}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="rule" x="0" y="56" width="802" height="1"><pen lineWidth="1.0" lineColor="#1F3A5F"/></element><element kind="textField" x="0" y="60" width="802" height="18" fontSize="9" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{CRITERIA_TEXT}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="0" y="80" width="401" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{printedBy} + ": " + ($P{PRINTED_BY} == null ? "" : $P{PRINTED_BY})]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="401" y="80" width="401" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{printedAt} + ": " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format($P{PRINTED_AT})]]></expression><box leftPadding="2" rightPadding="2"/></element></title>
	<detail><band height="18"><printWhenExpression><![CDATA[$F{line_no} != null]]></printWhenExpression><element kind="textField" x="0" y="0" width="51" height="18" pattern="#0" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$F{line_no}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="51" y="0" width="93" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$F{account_code}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="144" y="0" width="247" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$P{IS_AR} ? ($F{account_name_ar} != null && !$F{account_name_ar}.isBlank() ? $F{account_name_ar} : $F{account_name_en}) : ($F{account_name_en} != null && !$F{account_name_en}.isBlank() ? $F{account_name_en} : $F{account_name_ar})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="391" y="0" width="185" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$P{IS_AR} ? ($F{value_name_ar} != null && !$F{value_name_ar}.isBlank() ? $F{value_name_ar} : $F{value_name_en}) : ($F{value_name_en} != null && !$F{value_name_en}.isBlank() ? $F{value_name_en} : $F{value_name_ar})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="576" y="0" width="113" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{debit_amount}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="689" y="0" width="113" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{credit_amount}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></detail>
	<pageFooter height="20"><element kind="textField" x="281" y="4" width="120" height="14" fontSize="7.5" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{page} + " " + $V{PAGE_NUMBER} + " " + $R{of} + " "]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="401" y="4" width="60" height="14" fontSize="7.5" evaluationTime="Report" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA["" + $V{PAGE_NUMBER}]]></expression><box leftPadding="2" rightPadding="2"/></element></pageFooter>
	<summary height="20"><element kind="textField" x="0" y="0" width="802" height="20" bold="true" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{total} + ": " + $V{TEMPLATES} + " " + $R{templates}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></summary>
</jasperReport>
