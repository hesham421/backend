<?xml version="1.0" encoding="UTF-8"?>
<!-- dimension-values: FIN print template (JasperReports 7; editable in Jaspersoft Studio 7). Left-to-right design; the Arabic print mirrors it at load (TemplatePrinter). Labels: reports/fin/i18n/fin_<lang>.properties + the common print labels. The SQL reads POSTED lines live, exactly as ReportService does. -->
<jasperReport name="dimension-values" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenResourceMissingType="Key">
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.keep.first.band.1" value="columnHeader"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.band.2" value="pageFooter"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.logo" value="logo"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.printed" value="printed"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.sign" value="sign"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.rule" value="rule"/>
	<style name="Base" default="true" fontName="ERP Arabic" fontSize="8.5"/>
	<parameter name="REPORT_TITLE" class="java.lang.String"/>
	<parameter name="COMPANY_NAME" class="java.lang.String"/>
	<parameter name="COMPANY_LOGO" class="java.lang.Object"/>
	<parameter name="PRINTED_BY" class="java.lang.String"/>
	<parameter name="PRINTED_AT" class="java.util.Date"/>
	<parameter name="CRITERIA_TEXT" class="java.lang.String"/>
	<parameter name="IS_AR" class="java.lang.Boolean"/>
	<parameter name="IDS" class="java.lang.String"/>
	<query language="SQL"><![CDATA[WITH ids AS (
  SELECT CAST(x.id AS bigint) AS id, x.ord
  FROM unnest(string_to_array($P{IDS}, ',')) WITH ORDINALITY AS x(id, ord)
)
SELECT v.sort_order, v.code AS value_code, v.name_ar AS value_name_ar, v.name_en AS value_name_en,
       v.is_active_fl AS value_active
FROM ids JOIN fin_dimension_value v ON v.dimension_value_pk = ids.id
ORDER BY ids.ord]]></query>
	<field name="sort_order" class="java.math.BigDecimal"/>
	<field name="value_code" class="java.lang.String"/>
	<field name="value_name_ar" class="java.lang.String"/>
	<field name="value_name_en" class="java.lang.String"/>
	<field name="value_active" class="java.lang.Boolean"/>
	<variable name="ROWS" calculation="Count" class="java.lang.Integer"><expression><![CDATA[$F{value_code}]]></expression></variable>
	<title height="100"><element kind="image" key="logo" x="0" y="0" width="48" height="48" scaleImage="RetainShape" hImageAlign="Left" onErrorType="Blank"><expression><![CDATA[$P{COMPANY_LOGO}]]></expression></element><element kind="textField" x="0" y="0" width="555" height="26" fontSize="14" bold="true" forecolor="#1F3A5F" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{COMPANY_NAME}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="0" y="26" width="555" height="24" fontSize="12.5" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{REPORT_TITLE}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="rule" x="0" y="56" width="555" height="1"><pen lineWidth="1.0" lineColor="#1F3A5F"/></element><element kind="textField" x="0" y="60" width="555" height="18" fontSize="9" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{CRITERIA_TEXT}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="0" y="80" width="277" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{printedBy} + ": " + ($P{PRINTED_BY} == null ? "" : $P{PRINTED_BY})]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="277" y="80" width="278" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{printedAt} + ": " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format($P{PRINTED_AT})]]></expression><box leftPadding="2" rightPadding="2"/></element></title>
	<columnHeader height="30"><element kind="textField" x="0" y="0" width="44" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.sortOrder}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="44" y="0" width="75" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.code}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="119" y="0" width="187" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.nameAr}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="306" y="0" width="187" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.nameEn}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="493" y="0" width="62" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.status}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></columnHeader>
	<detail><band height="18"><element kind="textField" x="0" y="0" width="44" height="18" pattern="#0" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$F{sort_order}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="44" y="0" width="75" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$F{value_code}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="119" y="0" width="187" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$F{value_name_ar}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="306" y="0" width="187" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$F{value_name_en}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="493" y="0" width="62" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[Boolean.FALSE.equals($F{value_active}) ? $R{inactive} : $R{active}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></detail>
	<pageFooter height="20"><element kind="textField" x="157" y="4" width="120" height="14" fontSize="7.5" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{page} + " " + $V{PAGE_NUMBER} + " " + $R{of} + " "]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="277" y="4" width="60" height="14" fontSize="7.5" evaluationTime="Report" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA["" + $V{PAGE_NUMBER}]]></expression><box leftPadding="2" rightPadding="2"/></element></pageFooter>
	<summary height="20"><element kind="textField" x="0" y="0" width="555" height="20" bold="true" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{total} + ": " + $V{ROWS} + " " + $R{values}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></summary>
</jasperReport>
