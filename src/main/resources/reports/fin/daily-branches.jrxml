<?xml version="1.0" encoding="UTF-8"?>
<!-- daily-branches: FIN print template (JasperReports 7; editable in Jaspersoft Studio 7). Left-to-right design; the Arabic print mirrors it at load (TemplatePrinter). Labels: reports/fin/i18n/fin_<lang>.properties + the common print labels. The SQL reads POSTED lines live, exactly as ReportService does. -->
<jasperReport name="daily-branches" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenResourceMissingType="Key">
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.keep.first.band.1" value="columnHeader"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.band.2" value="pageFooter"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.logo" value="logo"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.printed" value="printed"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.sign" value="sign"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.rule" value="rule"/>
	<style name="Base" default="true" fontName="ERP Arabic" fontSize="8.5"/>
	<parameter name="REPORT_TITLE" class="java.lang.String"/>
	<parameter name="COMPANY_NAME" class="java.lang.String"/>
	<parameter name="COMPANY_LOGO" class="java.lang.Object"/>
	<parameter name="PRINTED_BY" class="java.lang.String"/>
	<parameter name="PRINTED_AT" class="java.util.Date"/>
	<parameter name="CRITERIA_TEXT" class="java.lang.String"/>
	<parameter name="IS_AR" class="java.lang.Boolean"/>
	<parameter name="DIMENSION_ID" class="java.lang.Long"/>
	<parameter name="DIMENSION_VALUE_ID" class="java.lang.Long"/>
	<parameter name="DAY" class="java.sql.Date"/>
	<query language="SQL"><![CDATA[WITH moves AS (
  SELECT jd.dimension_value_id, e.journal_entry_pk, a.account_type_code,
         CASE WHEN l.direction_code = 'DEBIT' THEN l.amount ELSE 0 END AS debit_amount,
         CASE WHEN l.direction_code = 'DEBIT' THEN 0 ELSE l.amount END AS credit_amount
  FROM fin_journal_line_dim jd
  JOIN fin_journal_line l ON l.journal_line_pk = jd.journal_line_id
  JOIN fin_journal_entry e ON e.journal_entry_pk = l.journal_entry_id
  JOIN fin_account a ON a.account_pk = l.account_id
  WHERE e.status_code = 'POSTED' AND jd.dimension_id = $P{DIMENSION_ID} AND e.doc_date = $P{DAY}
)
SELECT v.code AS value_code, v.name_ar AS value_name_ar, v.name_en AS value_name_en,
       COUNT(DISTINCT m.journal_entry_pk) AS entries,
       COALESCE(SUM(m.debit_amount), 0) AS debit_total, COALESCE(SUM(m.credit_amount), 0) AS credit_total,
       COALESCE(SUM(CASE WHEN m.account_type_code = 'REVENUE' THEN m.credit_amount - m.debit_amount END), 0) AS revenue,
       COALESCE(SUM(CASE WHEN m.account_type_code = 'EXPENSE' THEN m.debit_amount - m.credit_amount END), 0) AS expense
FROM fin_dimension_value v
LEFT JOIN moves m ON m.dimension_value_id = v.dimension_value_pk
WHERE v.dimension_id = $P{DIMENSION_ID}
  AND (CAST($P{DIMENSION_VALUE_ID} AS bigint) IS NULL OR v.dimension_value_pk = $P{DIMENSION_VALUE_ID})
GROUP BY v.dimension_value_pk, v.code, v.name_ar, v.name_en, v.sort_order
ORDER BY v.sort_order, v.code]]></query>
	<field name="value_code" class="java.lang.String"/>
	<field name="value_name_ar" class="java.lang.String"/>
	<field name="value_name_en" class="java.lang.String"/>
	<field name="entries" class="java.lang.Long"/>
	<field name="debit_total" class="java.math.BigDecimal"/>
	<field name="credit_total" class="java.math.BigDecimal"/>
	<field name="revenue" class="java.math.BigDecimal"/>
	<field name="expense" class="java.math.BigDecimal"/>
	<variable name="T_DEBIT" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{debit_total}]]></expression></variable>
	<variable name="T_CREDIT" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{credit_total}]]></expression></variable>
	<variable name="T_REVENUE" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{revenue}]]></expression></variable>
	<variable name="T_EXPENSE" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{expense}]]></expression></variable>
	<variable name="T_ENTRIES" calculation="Sum" class="java.lang.Long"><expression><![CDATA[$F{entries}]]></expression></variable>
	<title height="100"><element kind="image" key="logo" x="0" y="0" width="48" height="48" scaleImage="RetainShape" hImageAlign="Left" onErrorType="Blank"><expression><![CDATA[$P{COMPANY_LOGO}]]></expression></element><element kind="textField" x="0" y="0" width="802" height="26" fontSize="14" bold="true" forecolor="#1F3A5F" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{COMPANY_NAME}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="0" y="26" width="802" height="24" fontSize="12.5" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{REPORT_TITLE}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="rule" x="0" y="56" width="802" height="1"><pen lineWidth="1.0" lineColor="#1F3A5F"/></element><element kind="textField" x="0" y="60" width="802" height="18" fontSize="9" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{CRITERIA_TEXT}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="0" y="80" width="401" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{printedBy} + ": " + ($P{PRINTED_BY} == null ? "" : $P{PRINTED_BY})]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="401" y="80" width="401" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{printedAt} + ": " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format($P{PRINTED_AT})]]></expression><box leftPadding="2" rightPadding="2"/></element></title>
	<columnHeader height="30"><element kind="textField" x="0" y="0" width="68" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.valueCode}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="68" y="0" width="205" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.valueName}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="273" y="0" width="60" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.entries}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="333" y="0" width="94" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.debitTotal}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="427" y="0" width="94" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.creditTotal}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="521" y="0" width="94" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.revenue}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="615" y="0" width="94" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.expense}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="709" y="0" width="93" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.netResult}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></columnHeader>
	<detail><band height="18"><element kind="textField" x="0" y="0" width="68" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$F{value_code}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="68" y="0" width="205" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$P{IS_AR} ? ($F{value_name_ar} != null && !$F{value_name_ar}.isBlank() ? $F{value_name_ar} : $F{value_name_en}) : ($F{value_name_en} != null && !$F{value_name_en}.isBlank() ? $F{value_name_en} : $F{value_name_ar})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="273" y="0" width="60" height="18" pattern="#0" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$F{entries}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="333" y="0" width="94" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{debit_total}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="427" y="0" width="94" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{credit_total}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="521" y="0" width="94" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{revenue}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="615" y="0" width="94" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{expense}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="709" y="0" width="93" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{revenue}.subtract($F{expense})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></detail>
	<pageFooter height="20"><element kind="textField" x="281" y="4" width="120" height="14" fontSize="7.5" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{page} + " " + $V{PAGE_NUMBER} + " " + $R{of} + " "]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="401" y="4" width="60" height="14" fontSize="7.5" evaluationTime="Report" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA["" + $V{PAGE_NUMBER}]]></expression><box leftPadding="2" rightPadding="2"/></element></pageFooter>
	<summary height="90"><element kind="textField" x="0" y="0" width="273" height="20" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{total}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="273" y="0" width="60" height="20" bold="true" pattern="#,##0" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{T_ENTRIES}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="333" y="0" width="94" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{T_DEBIT}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="427" y="0" width="94" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{T_CREDIT}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="521" y="0" width="94" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{T_REVENUE}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="615" y="0" width="94" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{T_EXPENSE}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="709" y="0" width="93" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{T_REVENUE}.subtract($V{T_EXPENSE})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" key="sign" x="10" y="44" width="247" height="16" fontSize="9" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{sign.preparedBy}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="sign" x="30" y="84" width="207" height="1"><pen lineWidth="0.75" lineColor="#55606B"/></element><element kind="textField" key="sign" x="277" y="44" width="247" height="16" fontSize="9" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{sign.reviewedBy}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="sign" x="297" y="84" width="207" height="1"><pen lineWidth="0.75" lineColor="#55606B"/></element><element kind="textField" key="sign" x="544" y="44" width="247" height="16" fontSize="9" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{sign.approvedBy}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="sign" x="564" y="84" width="207" height="1"><pen lineWidth="0.75" lineColor="#55606B"/></element></summary>
</jasperReport>
