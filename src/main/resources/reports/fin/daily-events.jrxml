<?xml version="1.0" encoding="UTF-8"?>
<!-- daily-events: FIN print template (JasperReports 7; editable in Jaspersoft Studio 7). Left-to-right design; the Arabic print mirrors it at load (TemplatePrinter). Labels: reports/fin/i18n/fin_<lang>.properties + the common print labels. The SQL reads POSTED lines live, exactly as ReportService does. -->
<jasperReport name="daily-events" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenResourceMissingType="Key">
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.keep.first.band.1" value="columnHeader"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.band.2" value="pageFooter"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.logo" value="logo"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.printed" value="printed"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.sign" value="sign"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.rule" value="rule"/>
	<style name="Base" default="true" fontName="ERP Arabic" fontSize="8.5"/>
	<parameter name="REPORT_TITLE" class="java.lang.String"/>
	<parameter name="COMPANY_NAME" class="java.lang.String"/>
	<parameter name="COMPANY_LOGO" class="java.lang.Object"/>
	<parameter name="PRINTED_BY" class="java.lang.String"/>
	<parameter name="PRINTED_AT" class="java.util.Date"/>
	<parameter name="CRITERIA_TEXT" class="java.lang.String"/>
	<parameter name="IS_AR" class="java.lang.Boolean"/>
	<parameter name="IDS" class="java.lang.String"/>
	<parameter name="STATUS_LABELS" class="java.util.Map"/>
	<query language="SQL"><![CDATA[WITH ids AS (
  SELECT CAST(x.id AS bigint) AS id, x.ord
  FROM unnest(string_to_array($P{IDS}, ',')) WITH ORDINALITY AS x(id, ord)
)
SELECT ids.ord, e.journal_entry_pk AS entry_pk, e.doc_no, e.doc_date, e.journal_type_code, e.status_code,
       e.event_reference, e.description_ar, e.description_en, e.created_by, e.created_at,
       CASE WHEN e.event_reference LIKE 'LEGACY:%' THEN split_part(e.event_reference, ':', 2)
            ELSE COALESCE(NULLIF(split_part(e.event_reference, ':', 1), ''), e.event_reference) END AS event_source,
       CURRENT_DATE - CAST(e.created_at AS date) AS age_days,
       (SELECT COALESCE(SUM(l.amount), 0) FROM fin_journal_line l
         WHERE l.journal_entry_id = e.journal_entry_pk AND UPPER(l.direction_code) = 'DEBIT') AS entry_amount,
       (SELECT COUNT(*) FROM fin_journal_line l WHERE l.journal_entry_id = e.journal_entry_pk) AS line_count
FROM ids JOIN fin_journal_entry e ON e.journal_entry_pk = ids.id
WHERE e.event_reference IS NOT NULL
ORDER BY event_source, ids.ord]]></query>
	<field name="ord" class="java.lang.Long"/>
	<field name="entry_pk" class="java.lang.Long"/>
	<field name="doc_no" class="java.lang.String"/>
	<field name="doc_date" class="java.util.Date"/>
	<field name="journal_type_code" class="java.lang.String"/>
	<field name="status_code" class="java.lang.String"/>
	<field name="event_reference" class="java.lang.String"/>
	<field name="description_ar" class="java.lang.String"/>
	<field name="description_en" class="java.lang.String"/>
	<field name="created_by" class="java.lang.String"/>
	<field name="created_at" class="java.sql.Timestamp"/>
	<field name="event_source" class="java.lang.String"/>
	<field name="age_days" class="java.lang.Integer"/>
	<field name="entry_amount" class="java.math.BigDecimal"/>
	<field name="line_count" class="java.lang.Long"/>
	<variable name="G_AMOUNT" calculation="Sum" resetType="Group" resetGroup="SourceGroup" class="java.math.BigDecimal"><expression><![CDATA[$F{entry_amount}]]></expression></variable>
	<variable name="G_COUNT" calculation="Count" resetType="Group" resetGroup="SourceGroup" class="java.lang.Integer"><expression><![CDATA[$F{entry_pk}]]></expression></variable>
	<variable name="T_AMOUNT" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{entry_amount}]]></expression></variable>
	<variable name="T_COUNT" calculation="Count" class="java.lang.Integer"><expression><![CDATA[$F{entry_pk}]]></expression></variable>
	<group name="SourceGroup"><expression><![CDATA[$F{event_source}]]></expression><groupHeader><band height="26"><element kind="textField" x="0" y="4" width="802" height="20" fontSize="10" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{eventSource} + ": " + $F{event_source}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></groupHeader><groupFooter><band height="26"><element kind="textField" x="0" y="0" width="701" height="20" bold="true" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{totalOf} + " " + $F{event_source} + " (" + $V{G_COUNT} + " " + $R{events} + ")"]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="701" y="0" width="101" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{G_AMOUNT}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></groupFooter></group>
	<title height="100"><element kind="image" key="logo" x="0" y="0" width="48" height="48" scaleImage="RetainShape" hImageAlign="Left" onErrorType="Blank"><expression><![CDATA[$P{COMPANY_LOGO}]]></expression></element><element kind="textField" x="0" y="0" width="802" height="26" fontSize="14" bold="true" forecolor="#1F3A5F" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{COMPANY_NAME}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="0" y="26" width="802" height="24" fontSize="12.5" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{REPORT_TITLE}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="rule" x="0" y="56" width="802" height="1"><pen lineWidth="1.0" lineColor="#1F3A5F"/></element><element kind="textField" x="0" y="60" width="802" height="18" fontSize="9" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{CRITERIA_TEXT}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="0" y="80" width="401" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{printedBy} + ": " + ($P{PRINTED_BY} == null ? "" : $P{PRINTED_BY})]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="401" y="80" width="401" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{printedAt} + ": " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format($P{PRINTED_AT})]]></expression><box leftPadding="2" rightPadding="2"/></element></title>
	<columnHeader height="30"><element kind="textField" x="0" y="0" width="186" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.eventReference}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="186" y="0" width="110" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.docNo}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="296" y="0" width="76" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.docDate}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="372" y="0" width="253" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.description}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="625" y="0" width="76" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.status}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="701" y="0" width="101" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.amount}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></columnHeader>
	<detail><band height="18"><element kind="textField" x="0" y="0" width="186" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$F{event_reference}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="186" y="0" width="110" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$F{doc_no}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="296" y="0" width="76" height="18" pattern="yyyy-MM-dd" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$F{doc_date}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="372" y="0" width="253" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$P{IS_AR} ? ($F{description_ar} != null && !$F{description_ar}.isBlank() ? $F{description_ar} : $F{description_en}) : ($F{description_en} != null && !$F{description_en}.isBlank() ? $F{description_en} : $F{description_ar})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="625" y="0" width="76" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[(String) $P{STATUS_LABELS}.getOrDefault($F{status_code}, $F{status_code})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="701" y="0" width="101" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{entry_amount}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></detail>
	<pageFooter height="20"><element kind="textField" x="281" y="4" width="120" height="14" fontSize="7.5" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{page} + " " + $V{PAGE_NUMBER} + " " + $R{of} + " "]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="401" y="4" width="60" height="14" fontSize="7.5" evaluationTime="Report" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA["" + $V{PAGE_NUMBER}]]></expression><box leftPadding="2" rightPadding="2"/></element></pageFooter>
	<summary height="90"><element kind="textField" x="0" y="0" width="701" height="20" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{grandTotal} + " (" + $V{T_COUNT} + " " + $R{entries} + ")"]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="701" y="0" width="101" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{T_AMOUNT}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" key="sign" x="10" y="44" width="247" height="16" fontSize="9" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{sign.preparedBy}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="sign" x="30" y="84" width="207" height="1"><pen lineWidth="0.75" lineColor="#55606B"/></element><element kind="textField" key="sign" x="277" y="44" width="247" height="16" fontSize="9" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{sign.reviewedBy}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="sign" x="297" y="84" width="207" height="1"><pen lineWidth="0.75" lineColor="#55606B"/></element><element kind="textField" key="sign" x="544" y="44" width="247" height="16" fontSize="9" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{sign.approvedBy}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="sign" x="564" y="84" width="207" height="1"><pen lineWidth="0.75" lineColor="#55606B"/></element></summary>
</jasperReport>
