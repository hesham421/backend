<?xml version="1.0" encoding="UTF-8"?>
<!-- journal-entries: FIN print template (JasperReports 7; editable in Jaspersoft Studio 7). Left-to-right design; the Arabic print mirrors it at load (TemplatePrinter). Labels: reports/fin/i18n/fin_<lang>.properties + the common print labels. The SQL reads POSTED lines live, exactly as ReportService does. -->
<jasperReport name="journal-entries" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenResourceMissingType="Key">
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.keep.first.band.1" value="columnHeader"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.band.2" value="pageFooter"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.logo" value="logo"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.printed" value="printed"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.sign" value="sign"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.rule" value="rule"/>
	<style name="Base" default="true" fontName="ERP Arabic" fontSize="8.5"/>
	<parameter name="REPORT_TITLE" class="java.lang.String"/>
	<parameter name="COMPANY_NAME" class="java.lang.String"/>
	<parameter name="COMPANY_LOGO" class="java.lang.Object"/>
	<parameter name="PRINTED_BY" class="java.lang.String"/>
	<parameter name="PRINTED_AT" class="java.util.Date"/>
	<parameter name="CRITERIA_TEXT" class="java.lang.String"/>
	<parameter name="IS_AR" class="java.lang.Boolean"/>
	<parameter name="ENTRY_IDS" class="java.lang.String"/>
	<parameter name="JOURNAL_TYPE_LABELS" class="java.util.Map"/>
	<parameter name="STATUS_LABELS" class="java.util.Map"/>
	<query language="SQL"><![CDATA[WITH ids AS (
  SELECT CAST(x.id AS bigint) AS entry_id, x.ord AS entry_order
  FROM unnest(string_to_array($P{ENTRY_IDS}, ',')) WITH ORDINALITY AS x(id, ord)
)
SELECT ids.entry_order, e.journal_entry_pk AS entry_pk, e.doc_no, e.doc_date, e.journal_type_code, e.status_code,
       e.event_reference, e.description_ar AS entry_desc_ar, e.description_en AS entry_desc_en,
       o.doc_no AS original_doc_no, r.doc_no AS reversal_doc_no,
       l.line_no, a.code AS account_code, a.name_ar AS account_name_ar, a.name_en AS account_name_en,
       l.description_ar AS line_desc_ar, l.description_en AS line_desc_en,
       CASE WHEN UPPER(l.direction_code) = 'DEBIT' THEN l.amount ELSE 0 END AS debit_amount,
       CASE WHEN UPPER(l.direction_code) = 'DEBIT' THEN 0 ELSE l.amount END AS credit_amount,
       (SELECT string_agg(COALESCE(NULLIF(d.name_ar, ''), d.name_en) || ': ' || COALESCE(NULLIF(dv.name_ar, ''), dv.name_en), ' / ' ORDER BY d.code)
        FROM fin_journal_line_dim jd JOIN fin_dimension d ON d.dimension_pk = jd.dimension_id
        JOIN fin_dimension_value dv ON dv.dimension_value_pk = jd.dimension_value_id
        WHERE jd.journal_line_id = l.journal_line_pk) AS dims_ar,
       (SELECT string_agg(COALESCE(NULLIF(d.name_en, ''), d.name_ar) || ': ' || COALESCE(NULLIF(dv.name_en, ''), dv.name_ar), ' / ' ORDER BY d.code)
        FROM fin_journal_line_dim jd JOIN fin_dimension d ON d.dimension_pk = jd.dimension_id
        JOIN fin_dimension_value dv ON dv.dimension_value_pk = jd.dimension_value_id
        WHERE jd.journal_line_id = l.journal_line_pk) AS dims_en
FROM ids
JOIN fin_journal_entry e ON e.journal_entry_pk = ids.entry_id
LEFT JOIN fin_journal_entry o ON o.journal_entry_pk = e.original_entry_id
LEFT JOIN fin_journal_entry r ON r.journal_entry_pk = e.reversal_entry_id
LEFT JOIN fin_journal_line l ON l.journal_entry_id = e.journal_entry_pk
LEFT JOIN fin_account a ON a.account_pk = l.account_id
ORDER BY ids.entry_order, l.line_no]]></query>
	<field name="entry_order" class="java.lang.Long"/>
	<field name="entry_pk" class="java.lang.Long"/>
	<field name="doc_no" class="java.lang.String"/>
	<field name="doc_date" class="java.util.Date"/>
	<field name="journal_type_code" class="java.lang.String"/>
	<field name="status_code" class="java.lang.String"/>
	<field name="event_reference" class="java.lang.String"/>
	<field name="entry_desc_ar" class="java.lang.String"/>
	<field name="entry_desc_en" class="java.lang.String"/>
	<field name="original_doc_no" class="java.lang.String"/>
	<field name="reversal_doc_no" class="java.lang.String"/>
	<field name="line_no" class="java.math.BigDecimal"/>
	<field name="account_code" class="java.lang.String"/>
	<field name="account_name_ar" class="java.lang.String"/>
	<field name="account_name_en" class="java.lang.String"/>
	<field name="line_desc_ar" class="java.lang.String"/>
	<field name="line_desc_en" class="java.lang.String"/>
	<field name="debit_amount" class="java.math.BigDecimal"/>
	<field name="credit_amount" class="java.math.BigDecimal"/>
	<field name="dims_ar" class="java.lang.String"/>
	<field name="dims_en" class="java.lang.String"/>
	<variable name="E_DEBIT" calculation="Sum" resetType="Group" resetGroup="EntryGroup" class="java.math.BigDecimal"><expression><![CDATA[$F{debit_amount}]]></expression></variable>
	<variable name="E_CREDIT" calculation="Sum" resetType="Group" resetGroup="EntryGroup" class="java.math.BigDecimal"><expression><![CDATA[$F{credit_amount}]]></expression></variable>
	<variable name="T_DEBIT" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{debit_amount}]]></expression></variable>
	<variable name="T_CREDIT" calculation="Sum" class="java.math.BigDecimal"><expression><![CDATA[$F{credit_amount}]]></expression></variable>
	<variable name="ENTRIES" calculation="DistinctCount" class="java.lang.Integer"><expression><![CDATA[$F{entry_pk}]]></expression></variable>
	<group name="EntryGroup" keepTogether="true" minHeightToStartNewPage="130"><expression><![CDATA[$F{entry_pk}]]></expression><groupHeader><band height="68"><element kind="textField" x="0" y="6" width="200" height="20" fontSize="9" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{entry.no} + ": " + $F{doc_no}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="200" y="6" width="200" height="20" fontSize="9" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{entry.date} + ": " + ($F{doc_date} == null ? "" : new java.text.SimpleDateFormat("yyyy-MM-dd").format($F{doc_date}))]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="400" y="6" width="200" height="20" fontSize="9" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{entry.type} + ": " + (String) $P{JOURNAL_TYPE_LABELS}.getOrDefault($F{journal_type_code}, $F{journal_type_code})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="600" y="6" width="202" height="20" fontSize="9" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{entry.status} + ": " + (String) $P{STATUS_LABELS}.getOrDefault($F{status_code}, $F{status_code})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="0" y="26" width="802" height="20" fontSize="8.5" mode="Opaque" backcolor="#FFFFFF" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{entry.description} + ": " + ($P{IS_AR} ? ($F{entry_desc_ar} != null && !$F{entry_desc_ar}.isBlank() ? $F{entry_desc_ar} : $F{entry_desc_en}) : ($F{entry_desc_en} != null && !$F{entry_desc_en}.isBlank() ? $F{entry_desc_en} : $F{entry_desc_ar}) == null ? "—" : $P{IS_AR} ? ($F{entry_desc_ar} != null && !$F{entry_desc_ar}.isBlank() ? $F{entry_desc_ar} : $F{entry_desc_en}) : ($F{entry_desc_en} != null && !$F{entry_desc_en}.isBlank() ? $F{entry_desc_en} : $F{entry_desc_ar})) + ($F{event_reference} == null ? "" : "   |   " + $R{entry.reference} + ": " + $F{event_reference}) + ($F{original_doc_no} == null ? "" : "   |   " + $R{entry.reverses} + ": " + $F{original_doc_no}) + ($F{reversal_doc_no} == null ? "" : "   |   " + $R{entry.reversedBy} + ": " + $F{reversal_doc_no})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="0" y="46" width="41" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.lineNo}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="41" y="46" width="74" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.accountCode}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="115" y="46" width="164" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.accountName}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="279" y="46" width="180" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.description}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="459" y="46" width="147" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.dimensions}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="606" y="46" width="98" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.debit}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="704" y="46" width="98" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.credit}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></groupHeader><groupFooter><band height="30"><element kind="textField" x="0" y="0" width="606" height="20" bold="true" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{entry.total}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="606" y="0" width="98" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{E_DEBIT}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="704" y="0" width="98" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{E_CREDIT}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></groupFooter></group>
	<title height="100"><element kind="image" key="logo" x="0" y="0" width="48" height="48" scaleImage="RetainShape" hImageAlign="Left" onErrorType="Blank"><expression><![CDATA[$P{COMPANY_LOGO}]]></expression></element><element kind="textField" x="0" y="0" width="802" height="26" fontSize="14" bold="true" forecolor="#1F3A5F" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{COMPANY_NAME}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="0" y="26" width="802" height="24" fontSize="12.5" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{REPORT_TITLE}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="rule" x="0" y="56" width="802" height="1"><pen lineWidth="1.0" lineColor="#1F3A5F"/></element><element kind="textField" x="0" y="60" width="802" height="18" fontSize="9" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{CRITERIA_TEXT}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="0" y="80" width="401" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{printedBy} + ": " + ($P{PRINTED_BY} == null ? "" : $P{PRINTED_BY})]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="401" y="80" width="401" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{printedAt} + ": " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format($P{PRINTED_AT})]]></expression><box leftPadding="2" rightPadding="2"/></element></title>
	<detail><band height="18"><printWhenExpression><![CDATA[$F{account_code} != null]]></printWhenExpression><element kind="textField" x="0" y="0" width="41" height="18" pattern="#0" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$F{line_no}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="41" y="0" width="74" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$F{account_code}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="115" y="0" width="164" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$P{IS_AR} ? ($F{account_name_ar} != null && !$F{account_name_ar}.isBlank() ? $F{account_name_ar} : $F{account_name_en}) : ($F{account_name_en} != null && !$F{account_name_en}.isBlank() ? $F{account_name_en} : $F{account_name_ar})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="279" y="0" width="180" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$P{IS_AR} ? ($F{line_desc_ar} != null && !$F{line_desc_ar}.isBlank() ? $F{line_desc_ar} : $F{line_desc_en}) : ($F{line_desc_en} != null && !$F{line_desc_en}.isBlank() ? $F{line_desc_en} : $F{line_desc_ar})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="459" y="0" width="147" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$P{IS_AR} ? $F{dims_ar} : $F{dims_en}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="606" y="0" width="98" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{debit_amount}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="704" y="0" width="98" height="18" pattern="#,##0.00" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$F{credit_amount}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></detail>
	<pageFooter height="20"><element kind="textField" x="281" y="4" width="120" height="14" fontSize="7.5" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{page} + " " + $V{PAGE_NUMBER} + " " + $R{of} + " "]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="401" y="4" width="60" height="14" fontSize="7.5" evaluationTime="Report" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA["" + $V{PAGE_NUMBER}]]></expression><box leftPadding="2" rightPadding="2"/></element></pageFooter>
	<summary height="90"><element kind="textField" x="0" y="0" width="606" height="20" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{grandTotal} + " (" + $V{ENTRIES} + " " + $R{entries} + ")"]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="606" y="0" width="98" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{T_DEBIT}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="704" y="0" width="98" height="20" bold="true" pattern="#,##0.00" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$V{T_CREDIT}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" key="sign" x="10" y="44" width="247" height="16" fontSize="9" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{sign.preparedBy}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="sign" x="30" y="84" width="207" height="1"><pen lineWidth="0.75" lineColor="#55606B"/></element><element kind="textField" key="sign" x="277" y="44" width="247" height="16" fontSize="9" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{sign.reviewedBy}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="sign" x="297" y="84" width="207" height="1"><pen lineWidth="0.75" lineColor="#55606B"/></element><element kind="textField" key="sign" x="544" y="44" width="247" height="16" fontSize="9" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{sign.approvedBy}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="sign" x="564" y="84" width="207" height="1"><pen lineWidth="0.75" lineColor="#55606B"/></element></summary>
</jasperReport>
