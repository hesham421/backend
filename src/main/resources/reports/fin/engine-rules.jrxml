<?xml version="1.0" encoding="UTF-8"?>
<!-- engine-rules: FIN print template (JasperReports 7; editable in Jaspersoft Studio 7). Left-to-right design; the Arabic print mirrors it at load (TemplatePrinter). Labels: reports/fin/i18n/fin_<lang>.properties + the common print labels. The SQL reads POSTED lines live, exactly as ReportService does. -->
<jasperReport name="engine-rules" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenResourceMissingType="Key">
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.keep.first.band.1" value="columnHeader"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.band.2" value="pageFooter"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.logo" value="logo"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.printed" value="printed"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.sign" value="sign"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.rule" value="rule"/>
	<style name="Base" default="true" fontName="ERP Arabic" fontSize="8.5"/>
	<parameter name="REPORT_TITLE" class="java.lang.String"/>
	<parameter name="COMPANY_NAME" class="java.lang.String"/>
	<parameter name="COMPANY_LOGO" class="java.lang.Object"/>
	<parameter name="PRINTED_BY" class="java.lang.String"/>
	<parameter name="PRINTED_AT" class="java.util.Date"/>
	<parameter name="CRITERIA_TEXT" class="java.lang.String"/>
	<parameter name="IS_AR" class="java.lang.Boolean"/>
	<parameter name="IDS" class="java.lang.String"/>
	<parameter name="EVENT_TYPE_LABELS" class="java.util.Map"/>
	<parameter name="DIRECTION_LABELS" class="java.util.Map"/>
	<parameter name="DERIVATION_LABELS" class="java.util.Map"/>
	<parameter name="AMOUNT_SOURCE_LABELS" class="java.util.Map"/>
	<parameter name="DISTRIBUTION_LABELS" class="java.util.Map"/>
	<parameter name="BUSINESS_FIELD_LABELS" class="java.util.Map"/>
	<query language="SQL"><![CDATA[WITH ids AS (
  SELECT CAST(x.id AS bigint) AS id, x.ord
  FROM unnest(string_to_array($P{IDS}, ',')) WITH ORDINALITY AS x(id, ord)
)
SELECT ids.ord, r.event_type_rule_pk AS rule_pk, r.event_type_code, r.name_ar, r.name_en, r.is_active_fl AS active,
       l.line_no, l.direction_code, l.account_derivation_type_code, l.account_derivation_value, l.account_business_field_code,
       l.amount_source_type_code, l.amount_source_value, l.distribution_type_code, l.is_remainder_fl
FROM ids JOIN fin_event_type_rule r ON r.event_type_rule_pk = ids.id
LEFT JOIN fin_rule_line l ON l.event_type_rule_id = r.event_type_rule_pk
ORDER BY ids.ord, l.line_no]]></query>
	<field name="ord" class="java.lang.Long"/>
	<field name="rule_pk" class="java.lang.Long"/>
	<field name="event_type_code" class="java.lang.String"/>
	<field name="name_ar" class="java.lang.String"/>
	<field name="name_en" class="java.lang.String"/>
	<field name="active" class="java.lang.Boolean"/>
	<field name="line_no" class="java.math.BigDecimal"/>
	<field name="direction_code" class="java.lang.String"/>
	<field name="account_derivation_type_code" class="java.lang.String"/>
	<field name="account_derivation_value" class="java.lang.String"/>
	<field name="account_business_field_code" class="java.lang.String"/>
	<field name="amount_source_type_code" class="java.lang.String"/>
	<field name="amount_source_value" class="java.lang.String"/>
	<field name="distribution_type_code" class="java.lang.String"/>
	<field name="is_remainder_fl" class="java.lang.Boolean"/>
	<variable name="RULE_LINES" calculation="Count" resetType="Group" resetGroup="RuleGroup" class="java.lang.Integer"><expression><![CDATA[$F{line_no}]]></expression></variable>
	<variable name="RULES" calculation="DistinctCount" class="java.lang.Integer"><expression><![CDATA[$F{rule_pk}]]></expression></variable>
	<group name="RuleGroup" keepTogether="true" minHeightToStartNewPage="130"><expression><![CDATA[$F{rule_pk}]]></expression><groupHeader><band height="48"><element kind="textField" x="0" y="6" width="267" height="20" fontSize="9" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{col.eventType} + ": " + ((String) $P{EVENT_TYPE_LABELS}.getOrDefault($F{event_type_code}, $F{event_type_code}))]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="267" y="6" width="267" height="20" fontSize="9" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{col.name} + ": " + ($P{IS_AR} ? ($F{name_ar} != null && !$F{name_ar}.isBlank() ? $F{name_ar} : $F{name_en}) : ($F{name_en} != null && !$F{name_en}.isBlank() ? $F{name_en} : $F{name_ar}))]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="534" y="6" width="268" height="20" fontSize="9" bold="true" mode="Opaque" backcolor="#E8EDF2" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{col.status} + ": " + (Boolean.FALSE.equals($F{active}) ? $R{inactive} : $R{active})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="0" y="26" width="47" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.lineNo}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="47" y="26" width="75" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.direction}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="122" y="26" width="245" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.accountDerivation}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="367" y="26" width="226" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.amountSource}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="593" y="26" width="132" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.distribution}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="725" y="26" width="77" height="22" fontSize="8" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.remainder}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></groupHeader><groupFooter><band height="26"><element kind="textField" x="0" y="0" width="802" height="20" bold="true" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{lineCount} + ": " + $V{RULE_LINES}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></groupFooter></group>
	<title height="100"><element kind="image" key="logo" x="0" y="0" width="48" height="48" scaleImage="RetainShape" hImageAlign="Left" onErrorType="Blank"><expression><![CDATA[$P{COMPANY_LOGO}]]></expression></element><element kind="textField" x="0" y="0" width="802" height="26" fontSize="14" bold="true" forecolor="#1F3A5F" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{COMPANY_NAME}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="0" y="26" width="802" height="24" fontSize="12.5" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{REPORT_TITLE}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="rule" x="0" y="56" width="802" height="1"><pen lineWidth="1.0" lineColor="#1F3A5F"/></element><element kind="textField" x="0" y="60" width="802" height="18" fontSize="9" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{CRITERIA_TEXT}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="0" y="80" width="401" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{printedBy} + ": " + ($P{PRINTED_BY} == null ? "" : $P{PRINTED_BY})]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="401" y="80" width="401" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{printedAt} + ": " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format($P{PRINTED_AT})]]></expression><box leftPadding="2" rightPadding="2"/></element></title>
	<detail><band height="18"><printWhenExpression><![CDATA[$F{line_no} != null]]></printWhenExpression><element kind="textField" x="0" y="0" width="47" height="18" pattern="#0" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$F{line_no}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="47" y="0" width="75" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[(String) $P{DIRECTION_LABELS}.getOrDefault($F{direction_code}, $F{direction_code})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="122" y="0" width="245" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[(String) $P{DERIVATION_LABELS}.getOrDefault($F{account_derivation_type_code}, $F{account_derivation_type_code}) + ($F{account_derivation_value} == null ? "" : ": " + $F{account_derivation_value}) + ($F{account_business_field_code} == null ? "" : " (" + (String) $P{BUSINESS_FIELD_LABELS}.getOrDefault($F{account_business_field_code}, $F{account_business_field_code}) + ")")]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="367" y="0" width="226" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[(String) $P{AMOUNT_SOURCE_LABELS}.getOrDefault($F{amount_source_type_code}, $F{amount_source_type_code}) + ($F{amount_source_value} == null ? "" : ": " + $F{amount_source_value})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="593" y="0" width="132" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[(String) $P{DISTRIBUTION_LABELS}.getOrDefault($F{distribution_type_code}, $F{distribution_type_code})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="725" y="0" width="77" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[Boolean.TRUE.equals($F{is_remainder_fl}) ? $R{yes} : $R{no}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></detail>
	<pageFooter height="20"><element kind="textField" x="281" y="4" width="120" height="14" fontSize="7.5" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{page} + " " + $V{PAGE_NUMBER} + " " + $R{of} + " "]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="401" y="4" width="60" height="14" fontSize="7.5" evaluationTime="Report" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA["" + $V{PAGE_NUMBER}]]></expression><box leftPadding="2" rightPadding="2"/></element></pageFooter>
	<summary height="20"><element kind="textField" x="0" y="0" width="802" height="20" bold="true" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{total} + ": " + $V{RULES} + " " + $R{rules}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></summary>
</jasperReport>
