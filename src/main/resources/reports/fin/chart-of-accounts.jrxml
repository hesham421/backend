<?xml version="1.0" encoding="UTF-8"?>
<!-- chart-of-accounts: FIN print template (JasperReports 7; editable in Jaspersoft Studio 7). Left-to-right design; the Arabic print mirrors it at load (TemplatePrinter). Labels: reports/fin/i18n/fin_<lang>.properties + the common print labels. The SQL reads POSTED lines live, exactly as ReportService does. -->
<jasperReport name="chart-of-accounts" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenResourceMissingType="Key">
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.keep.first.band.1" value="columnHeader"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.origin.band.2" value="pageFooter"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.logo" value="logo"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.printed" value="printed"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.sign" value="sign"/>
	<property name="net.sf.jasperreports.export.xlsx.exclude.key.rule" value="rule"/>
	<style name="Base" default="true" fontName="ERP Arabic" fontSize="8.5"/>
	<parameter name="REPORT_TITLE" class="java.lang.String"/>
	<parameter name="COMPANY_NAME" class="java.lang.String"/>
	<parameter name="COMPANY_LOGO" class="java.lang.Object"/>
	<parameter name="PRINTED_BY" class="java.lang.String"/>
	<parameter name="PRINTED_AT" class="java.util.Date"/>
	<parameter name="CRITERIA_TEXT" class="java.lang.String"/>
	<parameter name="IS_AR" class="java.lang.Boolean"/>
	<parameter name="ACCOUNTS" class="java.lang.String"/>
	<parameter name="TYPE_LABELS" class="java.util.Map"/>
	<parameter name="NATURE_LABELS" class="java.util.Map"/>
	<query language="SQL"><![CDATA[WITH ids AS (
  SELECT CAST(split_part(x.v, ':', 1) AS bigint) AS account_id, CAST(split_part(x.v, ':', 2) AS integer) AS depth,
         x.ord AS account_order
  FROM unnest(string_to_array($P{ACCOUNTS}, ',')) WITH ORDINALITY AS x(v, ord)
)
SELECT ids.account_order, ids.depth, a.code AS account_code, a.name_ar, a.name_en, a.account_type_code, a.nature_code,
       p.code AS parent_code, a.is_leaf_fl AS leaf, a.is_active_fl AS active
FROM ids
JOIN fin_account a ON a.account_pk = ids.account_id
LEFT JOIN fin_account p ON p.account_pk = a.parent_account_id
ORDER BY ids.account_order]]></query>
	<field name="account_order" class="java.lang.Long"/>
	<field name="depth" class="java.lang.Integer"/>
	<field name="account_code" class="java.lang.String"/>
	<field name="name_ar" class="java.lang.String"/>
	<field name="name_en" class="java.lang.String"/>
	<field name="account_type_code" class="java.lang.String"/>
	<field name="nature_code" class="java.lang.String"/>
	<field name="parent_code" class="java.lang.String"/>
	<field name="leaf" class="java.lang.Boolean"/>
	<field name="active" class="java.lang.Boolean"/>
	<variable name="ROWS" calculation="Count" class="java.lang.Integer"><expression><![CDATA[$F{account_code}]]></expression></variable>
	<title height="100"><element kind="image" key="logo" x="0" y="0" width="48" height="48" scaleImage="RetainShape" hImageAlign="Left" onErrorType="Blank"><expression><![CDATA[$P{COMPANY_LOGO}]]></expression></element><element kind="textField" x="0" y="0" width="802" height="26" fontSize="14" bold="true" forecolor="#1F3A5F" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{COMPANY_NAME}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="0" y="26" width="802" height="24" fontSize="12.5" bold="true" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{REPORT_TITLE}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="line" key="rule" x="0" y="56" width="802" height="1"><pen lineWidth="1.0" lineColor="#1F3A5F"/></element><element kind="textField" x="0" y="60" width="802" height="18" fontSize="9" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$P{CRITERIA_TEXT}]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="0" y="80" width="401" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{printedBy} + ": " + ($P{PRINTED_BY} == null ? "" : $P{PRINTED_BY})]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" key="printed" x="401" y="80" width="401" height="16" fontSize="7.5" forecolor="#55606B" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{printedAt} + ": " + new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm").format($P{PRINTED_AT})]]></expression><box leftPadding="2" rightPadding="2"/></element></title>
	<columnHeader height="30"><element kind="textField" x="0" y="0" width="107" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.accountCode}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="107" y="0" width="267" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.accountName}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="374" y="0" width="107" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.accountType}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="481" y="0" width="80" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.nature}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="561" y="0" width="98" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.parentAccount}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="659" y="0" width="71" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.postable}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="730" y="0" width="72" height="30" fontSize="8.5" bold="true" mode="Opaque" backcolor="#1F3A5F" forecolor="#FFFFFF" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$R{col.status}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></columnHeader>
	<detail><band height="18"><element kind="textField" x="0" y="0" width="107" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$F{account_code}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="107" y="0" width="267" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA["    ".repeat($F{depth} == null ? 0 : $F{depth}) + ($P{IS_AR} ? ($F{name_ar} != null && !$F{name_ar}.isBlank() ? $F{name_ar} : $F{name_en}) : ($F{name_en} != null && !$F{name_en}.isBlank() ? $F{name_en} : $F{name_ar}))]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="374" y="0" width="107" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[(String) $P{TYPE_LABELS}.getOrDefault($F{account_type_code}, $F{account_type_code})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="481" y="0" width="80" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[(String) $P{NATURE_LABELS}.getOrDefault($F{nature_code}, $F{nature_code})]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="561" y="0" width="98" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[$F{parent_code} == null ? $R{rootAccount} : $F{parent_code}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="659" y="0" width="71" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[Boolean.TRUE.equals($F{leaf}) ? $R{yes} : $R{no}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element><element kind="textField" x="730" y="0" width="72" height="18" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Center" vTextAlign="Middle"><expression><![CDATA[Boolean.TRUE.equals($F{active}) ? $R{active} : $R{inactive}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></band></detail>
	<pageFooter height="20"><element kind="textField" x="281" y="4" width="120" height="14" fontSize="7.5" blankWhenNull="true" hTextAlign="Right" vTextAlign="Middle"><expression><![CDATA[$R{page} + " " + $V{PAGE_NUMBER} + " " + $R{of} + " "]]></expression><box leftPadding="2" rightPadding="2"/></element><element kind="textField" x="401" y="4" width="60" height="14" fontSize="7.5" evaluationTime="Report" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA["" + $V{PAGE_NUMBER}]]></expression><box leftPadding="2" rightPadding="2"/></element></pageFooter>
	<summary height="20"><element kind="textField" x="0" y="0" width="802" height="20" bold="true" mode="Opaque" backcolor="#F4F6F8" stretchType="ContainerHeight" textAdjust="StretchHeight" blankWhenNull="true" hTextAlign="Left" vTextAlign="Middle"><expression><![CDATA[$R{total} + ": " + $V{ROWS} + " " + $R{accounts}]]></expression><box leftPadding="4" rightPadding="4"><pen lineWidth="0.5" lineColor="#9AA7B4"/></box></element></summary>
</jasperReport>
