# Copy to .env.prod (gitignored) and fill in with the CURRENT production values.
# Never invent new JWT_SECRET / FILE_ACCESS_TOKEN_SECRET values: changing them logs
# everyone out and invalidates issued file-access tokens.
# deploy.py uploads this file to the server as ~/erp-deploy/.env (chmod 600).

# --- passed to the erp-backend container ---
DB_URL=jdbc:postgresql://localhost:5432/erp_db
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=
FILE_ACCESS_TOKEN_SECRET=
FRONTEND_URL=http://localhost:80
CORS_ALLOWED_ORIGINS=http://89.117.37.75,http://89.117.37.75:80
REDIS_HOST=localhost
REDIS_PORT=6379
MANAGEMENT_HEALTH_MAIL_ENABLED=false
# SMTP account for activation / password-reset mails (empty = no mail sent)
MAIL_USERNAME=
MAIL_PASSWORD=

# --- used by deploy.py only (backup / checks) ---
DB_CONTAINER=postgres-db
DB_NAME=erp_db
PUBLIC_URL=http://89.117.37.75
